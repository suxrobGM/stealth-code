<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StealthCode.Views.RegionSelectionWindow"
        Title="Select Region"
        WindowDecorations="None"
        WindowState="FullScreen"
        Topmost="True"
        Background="{StaticResource OverlayHitBrush}"
        Cursor="Cross">

  <Panel>
    <!-- Dim overlay -->
    <Border Classes="overlay-scrim" />

    <!-- Selection canvas -->
    <Canvas x:Name="SelectionCanvas" />

    <!-- Instructions -->
    <TextBlock Classes="overlay-hint"
               Text="Click and drag to select a region. Press Escape to cancel." />
  </Panel>
</Window>
