<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StealthCode.ViewModels.Settings"
             x:Class="StealthCode.Views.Settings.UpdateSection"
             x:DataType="vm:UpdateSettingsViewModel">

  <StackPanel Spacing="6">
    <Border Classes="divider" />

    <DockPanel>
      <TextBlock DockPanel.Dock="Left" Classes="bar-text" Text="{Binding VersionText}" />
      <Button DockPanel.Dock="Right" Classes="link" HorizontalAlignment="Right"
              Content="Check for updates"
              Command="{Binding CheckForUpdateCommand}"
              IsEnabled="{Binding !IsBusy}"
              IsVisible="{Binding !HasPendingRelease}" />
    </DockPanel>

    <TextBlock Classes="status" Text="{Binding StatusText}"
               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Applying exits the process -->
    <Button Classes="form-button" HorizontalAlignment="Stretch"
            Content="{Binding InstallButtonText}"
            Command="{Binding InstallUpdateCommand}"
            IsEnabled="{Binding !IsBusy}"
            IsVisible="{Binding HasPendingRelease}" />
  </StackPanel>
</UserControl>
