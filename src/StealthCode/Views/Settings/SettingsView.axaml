<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StealthCode.ViewModels.Shell"
             xmlns:settings="using:StealthCode.ViewModels.Settings"
             xmlns:views="using:StealthCode.Views.Settings"
             x:Class="StealthCode.Views.Settings.SettingsView"
             x:DataType="settings:SettingsViewModel"
             Width="320" Background="{StaticResource PanelBg}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16,12">

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Left" Classes="dialog-title" Text="Settings" />
      <Button Classes="chrome" DockPanel.Dock="Right" Content="{StaticResource IconClose}"
              Width="28" HorizontalAlignment="Right"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSettingsCommand}" />
    </DockPanel>

    <TabControl Grid.Row="1" Padding="0" SelectedIndex="{Binding SelectedTabIndex}">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" Margin="0,0,0,14" />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>

      <TabItem Header="General">
        <ScrollViewer>
          <views:GeneralSection DataContext="{Binding General}" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Capture">
        <ScrollViewer>
          <views:CaptureSection DataContext="{Binding Capture}" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Audio">
        <ScrollViewer>
          <views:AudioSection DataContext="{Binding Audio}" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Context">
        <ScrollViewer>
          <views:ContextSection DataContext="{Binding Context}" />
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <views:UpdateSection Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding Updates}" />

  </Grid>
</UserControl>
