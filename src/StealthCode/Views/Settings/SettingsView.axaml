<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StealthCode.ViewModels"
             xmlns:settings="using:StealthCode.ViewModels.Settings"
             xmlns:views="using:StealthCode.Views.Settings"
             x:Class="StealthCode.Views.Settings.SettingsView"
             x:DataType="settings:SettingsViewModel"
             Width="320" Background="{StaticResource PanelBg}">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12">

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Left" Classes="dialog-title" Text="Settings" />
      <Button Classes="chrome" DockPanel.Dock="Right" Content="{StaticResource IconClose}"
              Width="28" HorizontalAlignment="Right"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSettingsCommand}" />
    </DockPanel>

    <!-- One tab at a time -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="0,0,0,14">
      <Button Classes="tab" Classes.selected="{Binding IsGeneralTab}" Content="General"
              Command="{Binding SelectTabCommand}"
              CommandParameter="{x:Static settings:SettingsTab.General}" />
      <Button Classes="tab" Classes.selected="{Binding IsCaptureTab}" Content="Capture"
              Command="{Binding SelectTabCommand}"
              CommandParameter="{x:Static settings:SettingsTab.Capture}" />
      <Button Classes="tab" Classes.selected="{Binding IsAudioTab}" Content="Audio"
              Command="{Binding SelectTabCommand}"
              CommandParameter="{x:Static settings:SettingsTab.Audio}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <!-- Wrapper keeps IsVisible on this view model; the section swaps DataContext -->
      <Panel>
        <Panel IsVisible="{Binding IsGeneralTab}">
          <views:GeneralSection DataContext="{Binding General}" />
        </Panel>
        <Panel IsVisible="{Binding IsCaptureTab}">
          <views:CaptureSection DataContext="{Binding Capture}" />
        </Panel>
        <Panel IsVisible="{Binding IsAudioTab}">
          <views:AudioSection DataContext="{Binding Audio}" />
        </Panel>
      </Panel>
    </ScrollViewer>

    <views:UpdateSection Grid.Row="3" Margin="0,12,0,0" DataContext="{Binding Updates}" />

  </Grid>
</UserControl>
