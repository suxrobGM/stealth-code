<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StealthCode.ViewModels.Settings"
             x:Class="StealthCode.Views.Settings.ContextSection"
             x:DataType="vm:ContextSettingsViewModel">
  <StackPanel Spacing="16">

    <StackPanel Spacing="2">
      <CheckBox Content="Send with every request" IsChecked="{Binding UseSavedContext}" />
      <TextBlock Classes="field-hint"
                 Text="The saved profile accompanies audio and screenshot prompts. Turning it off affects only future requests." />
    </StackPanel>

    <StackPanel Spacing="4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="link" Content="Import resume..."
                Click="OnImportResumeClick" IsEnabled="{Binding !IsImporting}"
                ToolTip.Tip="PDF, DOCX, or TXT up to 10 MiB. Read locally; you review it before it replaces anything." />
        <TextBlock Classes="field-label" Text="Background" />
      </DockPanel>
      <TextBox Classes="form-input" Height="120" AcceptsReturn="True" TextWrapping="Wrap"
               PlaceholderText="Employment, projects, education, skills, and dates."
               Text="{Binding Background}" />
      <TextBlock Classes="status" Text="Reading resume..." IsVisible="{Binding IsImporting}" />
    </StackPanel>

    <StackPanel Spacing="4" IsVisible="{Binding HasImportPreview}">
      <TextBlock Classes="field-label" Text="{Binding PreviewCharacterCountText}" />
      <TextBox Classes="form-input" Height="160" AcceptsReturn="True" TextWrapping="Wrap"
               Text="{Binding ImportPreview}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="form-button compact" Content="Replace background" Command="{Binding ReplaceBackgroundCommand}" />
        <Button Classes="form-button compact" Content="Discard" Command="{Binding CancelImportCommand}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Classes="field-label" Text="Experience stories" />
      <TextBox Classes="form-input" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
               PlaceholderText="Real examples: the situation, what you did yourself, and the result."
               Text="{Binding ExperienceStories}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Classes="field-label" Text="Opportunity" />
      <TextBox Classes="form-input" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
               PlaceholderText="Company, target role, and job description."
               Text="{Binding Opportunity}" />
    </StackPanel>

    <StackPanel Spacing="6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="field-hint" VerticalAlignment="Center"
                   Text="{Binding CharacterCountText}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="primary" Content="Save" Command="{Binding SaveProfileCommand}"
                  IsEnabled="{Binding HasUnsavedChanges}" />
          <Button Classes="link" Content="Discard changes" Command="{Binding ResetChangesCommand}"
                  IsVisible="{Binding HasUnsavedChanges}" />
        </StackPanel>
      </DockPanel>
      <TextBlock Classes="status warning" Text="Unsaved changes are lost when settings close."
                 IsVisible="{Binding HasUnsavedChanges}" />
      <TextBlock Classes="status" Text="{Binding SaveStatus}"
                 IsVisible="{Binding SaveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="status danger" Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

  </StackPanel>
</UserControl>
