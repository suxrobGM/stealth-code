<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StealthCode.ViewModels.Settings"
             xmlns:conv="using:StealthCode.Converters"
             xmlns:controls="using:StealthCode.Controls"
             x:Class="StealthCode.Views.Settings.GeneralSection"
             x:DataType="vm:GeneralSettingsViewModel">

  <StackPanel Spacing="16">

    <!-- Matches what the opacity hotkey cycles -->
    <StackPanel Spacing="6">
      <TextBlock Classes="field-label" Text="Opacity" />
      <ItemsControl ItemsSource="{x:Static vm:GeneralSettingsViewModel.OpacityPresets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:Double">
            <Button Classes="chip" Content="{Binding StringFormat={}{0:0%}}"
                    Classes.selected="{Binding $self.Tag}"
                    Command="{Binding $parent[ItemsControl].((vm:GeneralSettingsViewModel)DataContext).SetOpacityCommand}"
                    CommandParameter="{Binding}">
              <Button.Tag>
                <MultiBinding Converter="{x:Static conv:SameOpacityConverter.Instance}">
                  <Binding Path="." />
                  <Binding Path="$parent[ItemsControl].((vm:GeneralSettingsViewModel)DataContext).Opacity" />
                </MultiBinding>
              </Button.Tag>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border Classes="divider" />

    <!-- All five together: they share one global namespace -->
    <StackPanel Spacing="8">
      <TextBlock Classes="section-header" Text="SHORTCUTS" />

      <Grid ColumnDefinitions="*,150" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Grid.Row="0" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" Text="Capture and send" />
        <controls:HotkeyTextBox Grid.Row="0" Grid.Column="1" Hotkey="{Binding CaptureHotkey, Mode=TwoWay}" />

        <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" Text="Add to batch" />
        <controls:HotkeyTextBox Grid.Row="1" Grid.Column="1" Hotkey="{Binding MultiCaptureHotkey, Mode=TwoWay}" />

        <TextBlock Grid.Row="2" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" Text="Listen" />
        <controls:HotkeyTextBox Grid.Row="2" Grid.Column="1" Hotkey="{Binding AudioHotkey, Mode=TwoWay}" />

        <TextBlock Grid.Row="3" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" Text="Cycle opacity" />
        <controls:HotkeyTextBox Grid.Row="3" Grid.Column="1" Hotkey="{Binding OpacityHotkey, Mode=TwoWay}" />

        <TextBlock Grid.Row="4" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" Text="No-focus mode" />
        <controls:HotkeyTextBox Grid.Row="4" Grid.Column="1" Hotkey="{Binding NoFocusHotkey, Mode=TwoWay}" />
      </Grid>

      <TextBlock Classes="field-hint"
                 Text="No-focus mode keeps the window from stealing focus when clicked, so your browser stays active." />

      <TextBlock Classes="status danger" Text="{Binding HotkeyConflict}"
                 IsVisible="{Binding HotkeyConflict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

  </StackPanel>
</UserControl>
