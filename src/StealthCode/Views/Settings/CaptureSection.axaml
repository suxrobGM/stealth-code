<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StealthCode.ViewModels.Settings"
             xmlns:capture="using:StealthCode.ScreenCapture.Models"
             x:Class="StealthCode.Views.Settings.CaptureSection"
             x:DataType="vm:CaptureSettingsViewModel">

  <StackPanel Spacing="16">

    <StackPanel Spacing="4">
      <TextBlock Classes="field-label" Text="Mode" />
      <ComboBox Classes="form-input" HorizontalAlignment="Stretch"
                SelectedValue="{Binding SelectedMode}"
                SelectedValueBinding="{Binding Tag, x:DataType=ComboBoxItem}">
        <ComboBoxItem Content="Full screen" Tag="{x:Static capture:CaptureMode.FullScreen}" />
        <ComboBoxItem Content="Region" Tag="{x:Static capture:CaptureMode.Region}" />
        <ComboBoxItem Content="Window" Tag="{x:Static capture:CaptureMode.Window}" />
      </ComboBox>

      <DockPanel IsVisible="{Binding IsRegionMode}">
        <Button DockPanel.Dock="Left" Classes="form-button" Content="Select region"
                Command="{Binding SelectRegionCommand}" />
        <TextBlock Classes="field-hint" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding RegionDisplayText}" />
      </DockPanel>

      <DockPanel IsVisible="{Binding IsWindowMode}">
        <Button DockPanel.Dock="Left" Classes="form-button" Content="Select window"
                Command="{Binding SelectWindowCommand}" />
        <TextBlock Classes="field-hint" Margin="8,0,0,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   Text="{Binding SelectedWindowTitle}" />
      </DockPanel>
    </StackPanel>

    <StackPanel Spacing="4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="link" Content="Reset"
                Command="{Binding ResetPromptCommand}" />
        <TextBlock Classes="field-label" Text="Prompt" />
      </DockPanel>
      <TextBox Classes="form-input" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
               Text="{Binding SystemPrompt}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="link" Content="Reset"
                Command="{Binding ResetMultiCapturePromptCommand}" />
        <TextBlock Classes="field-label" Text="Batch prompt" />
      </DockPanel>
      <TextBox Classes="form-input" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
               Text="{Binding MultiCaptureSystemPrompt}" />
      <TextBlock Classes="field-hint"
                 Text="Sent with a batch so the screenshots read as one document, ignoring scroll overlap." />
    </StackPanel>

  </StackPanel>
</UserControl>
