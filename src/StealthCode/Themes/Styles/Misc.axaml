<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource DividerBrush}" />
  </Style>

  <!-- Region selection overlay -->
  <Style Selector="Border.overlay-scrim">
    <Setter Property="Background" Value="{StaticResource OverlayScrimBrush}" />
  </Style>

  <Style Selector="TextBlock.overlay-hint">
    <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
    <Setter Property="Foreground" Value="{StaticResource OverlayFg}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,40,0,0" />
  </Style>

</Styles>
