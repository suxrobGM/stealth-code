<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StealthCode.Controls.HotkeyTextBox">

  <StackPanel Spacing="4">
    <TextBox x:Name="Input" Classes="form-input" Height="28" />
    <TextBlock x:Name="ErrorText" Classes="status warning" IsVisible="False" />
  </StackPanel>
</UserControl>
