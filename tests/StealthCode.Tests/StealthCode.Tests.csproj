<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/StealthCode/StealthCode.csproj" />
    <Using Include="Xunit" />
    <None Update="Fixtures/*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
